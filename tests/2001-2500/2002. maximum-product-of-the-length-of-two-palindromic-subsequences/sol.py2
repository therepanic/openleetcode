class Solution(object):
    def maxProduct(self, s):
        """
        :type s: str
        :rtype: int
        """
        n = len(s)
        palin_masks = []

        def is_palindrome(mask):
            seq = []
            for i in range(n):
                if (mask >> i) & 1:
                    seq.append(s[i])
            return seq == seq[::-1]

        for mask in range(1, 1 << n):
            if is_palindrome(mask):
                palin_masks.append((mask, bin(mask).count("1")))

        max_product = 0
        for i in range(len(palin_masks)):
            for j in range(i + 1, len(palin_masks)):
                m1, l1 = palin_masks[i]
                m2, l2 = palin_masks[j]
                if m1 & m2 == 0: 
                    max_product = max(max_product, l1 * l2)

        return max_product
