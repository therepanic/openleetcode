class Solution(object):
    def closeStrings(self, word1, word2):
        """
        :type word1: str
        :type word2: str
        :rtype: bool
        """
        if len(word1) != len(word2):
            return False
        set1 = set(word1)
        set2 = set(word2)
        if set1 != set2:
            return False
        dct = {}
        for x in set1:
            n1 = word1.count(x)
            n2 = word2.count(x)
            dct[n1] = dct.get(n1, 0) + 1
            dct[n2] = dct.get(n2, 0) - 1
        for v in dct.values():
            if v != 0:
                return False
        return True
