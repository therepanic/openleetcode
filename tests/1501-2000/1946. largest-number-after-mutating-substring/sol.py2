class Solution(object):
    def maximumNumber(self, num, change):
        """
        :type num: str
        :type change: List[int]
        :rtype: str
        """
        a = list(num)
        flag = False
        for i in range(len(a)):
            b = int(a[i])
            if b < change[b]:
                a[i] = str(change[b])
                flag = True
            elif b == change[b] or not flag:
                continue
            else:
                break
        return "".join(a)
