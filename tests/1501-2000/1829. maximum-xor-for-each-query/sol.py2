class Solution(object):
    def getMaximumXor(self, nums, maximumBit):
        """
        :type nums: List[int]
        :type maximumBit: int
        :rtype: List[int]
        """
        ans = []
        n = len(nums)
        mask = (1 << maximumBit) - 1
        curr = 0
        for i in range(n):
            curr ^= nums[i]
            ans.append(mask ^ curr)
        ans.reverse()
        return ans
