class Solution(object):
    def getLucky(self, s, k):
        """
        :type s: str
        :type k: int
        :rtype: int
        """
        res = ''
        for c in s:
            res += str(ord(c) - ord('a') + 1)
        for _ in range(k):
            res = str(sum(int(x) for x in res))
        return int(res)
