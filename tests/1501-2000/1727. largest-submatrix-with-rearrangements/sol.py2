class Solution(object):
    def largestSubmatrix(self, matrix):
        """
        :type matrix: List[List[int]]
        :rtype: int
        """
        m, n = len(matrix), len(matrix[0])
        max_area = 0
        h = [0] * n
        for i in range(m):
            for j in range(n):
                if j < len(matrix[i]) and matrix[i][j] == 1:
                    h[j] += 1
                else:
                    h[j] = 0
            sh = sorted(h, reverse=True)
            for j in range(n):
                if sh[j] == 0:
                    break
                max_area = max(max_area, sh[j] * (j + 1))
        return max_area
