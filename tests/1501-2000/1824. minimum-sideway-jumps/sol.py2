class Solution(object):
    def minSideJumps(self, obstacles):
        """
        :type obstacles: List[int]
        :rtype: int
        """
        INF = float('inf')
        dp = [1, 0, 1]
        
        for i in range(1, len(obstacles)):
            obs = obstacles[i]
            for j in range(3):
                if obs == j + 1:
                    dp[j] = INF
            
            for j in range(3):
                if obs != j + 1:
                    dp[j] = min(dp[j], min(dp[(j + 1) % 3], dp[(j + 2) % 3]) + 1)
        
        return min(dp)
