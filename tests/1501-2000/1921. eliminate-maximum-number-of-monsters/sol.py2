class Solution(object):
    def eliminateMaximum(self, dist, speed):
        """
        :type dist: List[int]
        :type speed: List[int]
        :rtype: int
        """
        arrival = []
        for d, s in zip(dist, speed):
            arrival.append((d + s - 1) // s)
        arrival.sort()
        for minute, time in enumerate(arrival):
            if time <= minute:
                return minute
        return len(arrival)
