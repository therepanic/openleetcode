class Solution(object):
    def maxCoins(self, piles):
        """
        :type piles: List[int]
        :rtype: int
        """
        piles.sort()
        l = 0
        r = len(piles)
        count = 0
        for i in range(len(piles)//3):
            count += piles[r-2]
            l += 1
            r -= 2
        return count
