class Solution(object):
    def minCharacters(self, a, b):
        """
        :type a: str
        :type b: str
        :rtype: int
        """
        freq_a = [0] * 26
        freq_b = [0] * 26

        for ch in a:
            freq_a[ord(ch) - ord('a')] += 1
        for ch in b:
            freq_b[ord(ch) - ord('a')] += 1

        len_a = len(a)
        len_b = len(b)
        res = float('inf')
        sum_a = sum_b = 0

        for i in range(25):
            sum_a += freq_a[i]
            sum_b += freq_b[i]
            res = min(res, len_a - sum_a + sum_b)
            res = min(res, len_b - sum_b + sum_a)

        for i in range(26):
            res = min(res, (len_a - freq_a[i]) + (len_b - freq_b[i]))

        return res
