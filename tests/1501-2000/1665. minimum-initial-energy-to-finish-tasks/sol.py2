class Solution(object):
    def minimumEffort(self, tasks):
        """
        :type tasks: List[List[int]]
        :rtype: int
        """
        tasks.sort(key=lambda x: x[1] - x[0], reverse=True)
        def test(bal):
            for cost, thresh in tasks:
                if bal < thresh:
                    return False
                bal -= cost
            return True
        lo, hi = 0, 10**9 + 1
        while lo < hi:
            mid = (lo + hi) // 2
            if test(mid):
                hi = mid
            else:
                lo = mid + 1
        return lo
