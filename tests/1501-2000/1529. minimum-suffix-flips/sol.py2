class Solution(object):
    def minFlips(self, target):
        """
        :type target: str
        :rtype: int
        """
        minCount = 0
        flag = 0
        n = len(target)
        
        for i in range(n):
            if target[i] != chr(flag % 2 + ord('0')):
                minCount += 1
                flag += 1
        
        return minCount
