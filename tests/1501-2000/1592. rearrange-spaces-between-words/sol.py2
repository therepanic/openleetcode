class Solution(object):
    def reorderSpaces(self, text):
        """
        :type text: str
        :rtype: str
        """
        t = text.split()
        total = text.count(" ")
        if len(t) == 1:
            return t[0] + " " * total
        gap = total // (len(t) - 1)
        extra = total % (len(t) - 1)
        return (" " * gap).join(t) + " " * extra
