class Solution(object):
    def countMatches(self, items, ruleKey, ruleValue):
        """
        :type items: List[List[str]]
        :type ruleKey: str
        :type ruleValue: str
        :rtype: int
        """
        key_map={"type":0,"color":1,"name":2}
        count=0
        idx=key_map[ruleKey]
        for item in items:
            if item[idx]==ruleValue:
                count+=1
        return count
