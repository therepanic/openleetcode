class Solution(object):
    def minimumBoxes(self, n):
        """
        :type n: int
        :rtype: int
        """
        lo, hi = 0, 200000
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if mid * (mid + 1) * (mid + 2) // 6 <= n:
                lo = mid
            else:
                hi = mid - 1
        full = lo
        remaining = n - full * (full + 1) * (full + 2) // 6
        extra = 0
        while extra * (extra + 1) // 2 < remaining:
            extra += 1
        return full * (full + 1) // 2 + extra
