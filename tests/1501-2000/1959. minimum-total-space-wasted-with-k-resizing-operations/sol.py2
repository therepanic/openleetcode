class Solution(object):
    def minSpaceWastedKResizing(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        n = len(nums)
        P = [0] * (n + 1)
        for i in range(n):
            P[i+1] = P[i] + nums[i]
        dp = [float('inf')] * (n + 1)
        max_v = 0
        for i in range(1, n + 1):
            max_v = max(max_v, nums[i-1])
            dp[i] = max_v * i - P[i]
        for _ in range(k):
            new_dp = [float('inf')] * (n + 1)
            new_dp[0] = 0
            for i in range(1, n + 1):
                cur_max = 0
                for j in range(i - 1, -1, -1):
                    cur_max = max(cur_max, nums[j])
                    waste = cur_max * (i - j) - (P[i] - P[j])
                    new_dp[i] = min(new_dp[i], dp[j] + waste)
            dp = new_dp
        return dp[n]
