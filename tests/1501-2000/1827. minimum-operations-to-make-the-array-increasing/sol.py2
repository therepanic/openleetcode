class Solution(object):
    def minOperations(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        c=nums[0]
        s=0
        for i in range(1,len(nums)):
            if nums[i]>c:
                c=nums[i]
            else:
                c+=1
                s+=abs(c-nums[i])
        return s
