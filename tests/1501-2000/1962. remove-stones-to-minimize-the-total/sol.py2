class Solution(object):
    def minStoneSum(self, piles, k):
        """
        :type piles: List[int]
        :type k: int
        :rtype: int
        """
        import heapq
        piles = [-p for p in piles]
        heapq.heapify(piles)
        for _ in range(k):
            x = -heapq.heappop(piles)
            reduced = (x + 1) // 2
            heapq.heappush(piles, -reduced)
        return -sum(piles)
