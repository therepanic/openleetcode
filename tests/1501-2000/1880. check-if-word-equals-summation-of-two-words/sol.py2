class Solution(object):
    def isSumEqual(self, firstWord, secondWord, targetWord):
        """
        :type firstWord: str
        :type secondWord: str
        :type targetWord: str
        :rtype: bool
        """
        def convert(word):
            return int("".join(str(ord(ch) - ord("a")) for ch in word))

        return convert(firstWord) + convert(secondWord) == convert(targetWord)
