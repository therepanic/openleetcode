class Solution(object):
    def countConsistentStrings(self, allowed, words):
        """
        :type allowed: str
        :type words: List[str]
        :rtype: int
        """
        result = 0
        allowed_set = set(allowed)
        for word in words:
            all_in = True
            for c in word:
                if c not in allowed_set:
                    all_in = False
                    break
            if all_in:
                result += 1
        return result
