class Solution(object):
    def addRungs(self, rungs, dist):
        """
        :type rungs: List[int]
        :type dist: int
        :rtype: int
        """
        curr = 0
        res = 0
        for rung in rungs:
            if rung - curr > dist:
                res += (rung - curr - 1) / dist
            curr = rung
        return res
