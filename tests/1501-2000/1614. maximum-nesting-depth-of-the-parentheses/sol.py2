class Solution(object):
    def maxDepth(self, s):
        """
        :type s: str
        :rtype: int
        """
        ctr = 0
        ans = 0
        for ch in s:
            if ch == '(':
                ctr += 1
                ans = max(ans, ctr)
            elif ch == ')':
                ctr -= 1
        return ans
