class Solution(object):
    def thousandSeparator(self, n):
        """
        :type n: int
        :rtype: str
        """
        s = str(n)
        if len(s) <= 3:
            return s
        result = []
        count = 0
        for ch in reversed(s):
            result.append(ch)
            count += 1
            if count % 3 == 0 and count < len(s):
                result.append('.')
        return ''.join(reversed(result))
