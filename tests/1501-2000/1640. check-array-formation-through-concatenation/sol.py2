class Solution(object):
    def canFormArray(self, arr, pieces):
        """
        :type arr: List[int]
        :type pieces: List[List[int]]
        :rtype: bool
        """
        a=[]
        for i in arr:
            for j in pieces:
                if i in j:
                    for k in j:
                        a.append(k)
                    pieces.remove(j)
                    break
        if a==arr:
            return True
        return False
