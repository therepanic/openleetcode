class Solution(object):
    def maxScore(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = len(nums)
        def gcd(a, b):
            while b:
                a, b = b, a % b
            return a

        memo = {}
        def dp(mask, op):
            if (mask, op) in memo:
                return memo[(mask, op)]
            if mask == (1 << n) - 1:
                return 0
            ans = 0
            for i in range(n):
                if mask & (1 << i) == 0:
                    for j in range(n):
                        if j != i and mask & (1 << j) == 0:
                            nmask = mask | (1 << i) | (1 << j)
                            ans = max(ans, dp(nmask, op + 1) + gcd(nums[i], nums[j]) * op)
            memo[(mask, op)] = ans
            return ans
        return dp(0, 1)
