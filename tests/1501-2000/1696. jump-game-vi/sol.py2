class Solution(object):
    def maxResult(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        n = len(nums)
        dp = [0] * n
        dp[0] = nums[0]
        dq = [0]
        head = 0
        for i in range(1, n):
            if dq[head] < i - k:
                head += 1
            dp[i] = nums[i] + dp[dq[head]]
            while len(dq) > head and dp[dq[-1]] <= dp[i]:
                dq.pop()
            dq.append(i)
        return dp[-1]
