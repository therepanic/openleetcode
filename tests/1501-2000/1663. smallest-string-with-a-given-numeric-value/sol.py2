class Solution(object):
    def getSmallestString(self, n, k):
        """
        :type n: int
        :type k: int
        :rtype: str
        """
        res = ['a'] * n
        k -= n  

        i = n - 1
        while k > 0:
            add = min(25, k)  
            res[i] = chr(ord('a') + add)
            k -= add
            i -= 1

        return ''.join(res)
