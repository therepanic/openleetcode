class Solution(object):
    def minimumSize(self, nums, maxOperations):
        """
        :type nums: List[int]
        :type maxOperations: int
        :rtype: int
        """
        lo, hi = 1, max(nums)
        while lo < hi:
            mid = (lo + hi) // 2
            needed = sum((x - 1) // mid for x in nums)
            if needed <= maxOperations:
                hi = mid
            else:
                lo = mid + 1
        return lo
