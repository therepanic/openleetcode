class Solution(object):
    def maxValue(self, n, index, maxSum):
        """
        :type n: int
        :type index: int
        :type maxSum: int
        :rtype: int
        """
        def isValid(mid):
            leftCount = index
            if mid > leftCount:
                left = (mid - leftCount + mid - 1) * leftCount // 2
            else:
                ones = leftCount - (mid - 1)
                left = mid * (mid - 1) // 2 + ones

            rightCount = n - index - 1
            if mid > rightCount:
                right = (mid - 1 + mid - rightCount) * rightCount // 2
            else:
                ones = rightCount - (mid - 1)
                right = mid * (mid - 1) // 2 + ones

            return left + mid + right <= maxSum

        l, r, result = 0, maxSum, 1
        while l <= r:
            mid = (l + r) // 2
            if isValid(mid):
                result = mid
                l = mid + 1
            else:
                r = mid - 1
        return result
