class Solution(object):
    def rotateTheBox(self, boxGrid):
        """
        :type boxGrid: List[List[str]]
        :rtype: List[List[str]]
        """
        box = boxGrid
        r, c = len(box), len(box[0])
        rotate = [['.'] * r for _ in range(c)]
        for i in range(r):
            bottom = c - 1
            for j in range(c - 1, -1, -1):
                if box[i][j] == '#':
                    rotate[bottom][r - 1 - i] = '#'
                    bottom -= 1
                elif box[i][j] == '*':
                    rotate[j][r - 1 - i] = '*'
                    bottom = j - 1
        return rotate
