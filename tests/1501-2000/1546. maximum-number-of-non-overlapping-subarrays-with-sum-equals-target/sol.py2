class Solution(object):
    def maxNonOverlapping(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """
        num_of_subarrays, temp, visited = 0, 0, {0}
        for i, num in enumerate(nums):
            temp += num
            prev = temp - target
            if prev in visited:
                visited = set()
                num_of_subarrays += 1
            visited.add(temp)
        return num_of_subarrays
