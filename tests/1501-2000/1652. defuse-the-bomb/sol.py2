
class Solution(object):
    def decrypt(self, code, k):
        n = len(code)
        if k == 0:
            return [0] * n

        answer = []
        direction = 1 if k > 0 else -1
        for i in range(n):
            total = 0
            for offset in range(1, abs(k) + 1):
                total += code[(i + direction * offset) % n]
            answer.append(total)
        return answer
