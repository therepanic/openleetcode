class Solution(object):
    def canChoose(self, groups, nums):
        """
        :type groups: List[List[int]]
        :type nums: List[int]
        :rtype: bool
        """
        i = 0
        for group in groups:
            found = False
            while i + len(group) <= len(nums):
                if nums[i:i + len(group)] == group:
                    i += len(group)
                    found = True
                    break
                else:
                    i += 1
            if not found:
                return False
        return True
