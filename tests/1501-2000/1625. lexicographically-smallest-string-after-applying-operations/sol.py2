class Solution(object):
    def findLexSmallestString(self, s, a, b):
        """
        :type s: str
        :type a: int
        :type b: int
        :rtype: str
        """
        n = len(s)
        seen = set()
        def dfs(cur):
            if cur in seen:
                return
            seen.add(cur)
            add = list(cur)
            for i in range(1, n, 2):
                add[i] = str((int(add[i]) + a) % 10)
            dfs(''.join(add))
            dfs(cur[n-b:] + cur[:n-b])
        dfs(s)
        return min(seen)
