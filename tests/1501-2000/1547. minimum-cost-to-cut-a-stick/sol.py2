class Solution(object):
    def minCost(self, n, cuts):
        """
        :type n: int
        :type cuts: List[int]
        :rtype: int
        """
        c = sorted(cuts + [0, n])
        m = len(c)
        def optimize_manifold(i, j):
            key = (i, j)
            if key in memo:
                return memo[key]
            if j - i <= 1:
                return 0
            res = min(optimize_manifold(i, k) + optimize_manifold(k, j) 
                      for k in range(i + 1, j))
            memo[key] = res + (c[j] - c[i])
            return memo[key]
        
        memo = {}
        return optimize_manifold(0, m - 1)
