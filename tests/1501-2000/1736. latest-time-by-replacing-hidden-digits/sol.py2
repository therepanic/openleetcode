class Solution(object):
    def maximumTime(self, time):
        """
        :type time: str
        :rtype: str
        """
        len_time_str = len(time)
        ret_val = ''
        i = 0
        while i < len_time_str:
            c = time[i]
            if c == '?':
                if i == 0:
                    if time[i+1] == '?':
                        ret_val += '2'
                    elif time[i+1] in ('0', '1', '2', '3'):
                        ret_val += '2'
                    else:
                        ret_val += '1'
                elif i == 1:
                    if time[i-1] == '?':
                        ret_val += '3'
                    elif time[i-1] in ('0', '1'):
                        ret_val += '9'
                    else:
                        ret_val += '3'
                elif i == 3:
                    ret_val += '5'
                elif i == 4:
                    ret_val += '9'
            else:
                ret_val += c
            i += 1
        return ret_val
