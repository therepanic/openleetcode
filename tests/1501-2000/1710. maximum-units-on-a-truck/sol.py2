class Solution(object):
    def maximumUnits(self, boxTypes, truckSize):
        """
        :type boxTypes: List[List[int]]
        :type truckSize: int
        :rtype: int
        """
        boxTypes.sort(reverse=True, key=lambda x: x[1])
        ans = 0
        for a, b in boxTypes:
            quantitytaken = min(truckSize, a)
            ans += b * quantitytaken
            truckSize -= quantitytaken
            if truckSize == 0:
                break
        return ans
