class Solution(object):
    def halvesAreAlike(self, s):
        """
        :type s: str
        :rtype: bool
        """
        vowels = set('aeiouAEIOU')
        mid = len(s) // 2
        count = 0
        for i in range(mid):
            if s[i] in vowels:
                count += 1
        for i in range(mid, len(s)):
            if s[i] in vowels:
                count -= 1
        return count == 0
