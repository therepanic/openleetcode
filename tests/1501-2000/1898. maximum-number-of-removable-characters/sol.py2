class Solution(object):
    def maximumRemovals(self, s, p, removable):
        """
        :type s: str
        :type p: str
        :type removable: List[int]
        :rtype: int
        """
        def is_subsequence(s, p, removed):
            i = j = 0
            while i < len(s) and j < len(p):
                if i in removed or s[i] != p[j]:
                    i += 1
                else:
                    i += 1
                    j += 1
            return j == len(p)
        
        left, right = 0, len(removable)
        max_k = 0
        while left <= right:
            mid = (left + right) // 2
            removed = set(removable[:mid])
            if is_subsequence(s, p, removed):
                max_k = mid
                left = mid + 1
            else:
                right = mid - 1
        return max_k
