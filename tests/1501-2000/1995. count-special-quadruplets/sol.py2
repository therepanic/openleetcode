class Solution(object):
    def countQuadruplets(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        res, n = 0, len(nums)
        for w in range(n):
            for x in range(w + 1, n):
                for y in range(x + 1, n):
                    for z in range(y + 1, n):
                        res += 1 if nums[w] + nums[x] + nums[y] == nums[z] else 0
        return res
