class Solution(object):
    def isCovered(self, ranges, left, right):
        """
        :type ranges: List[List[int]]
        :type left: int
        :type right: int
        :rtype: bool
        """
        slots = [0] * 51
        for s, e in ranges:
            for i in range(s, e + 1):
                slots[i] = 1
        for i in range(left, right + 1):
            if slots[i] == 0:
                return False
        return True
