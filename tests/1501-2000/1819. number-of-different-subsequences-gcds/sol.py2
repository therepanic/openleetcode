class Solution(object):
    def countDifferentSubsequenceGCDs(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        seen = set(nums)
        maxi = max(nums)
        cnt = 0
        for i in range(1, maxi+1):
            gd = 0
            for j in range(i, maxi+1, i):
                if j in seen:
                    gd = self._gcd(gd, j)
            if gd == i:
                cnt += 1
        return cnt
    
    def _gcd(self, a, b):
        while b:
            a, b = b, a % b
        return a
