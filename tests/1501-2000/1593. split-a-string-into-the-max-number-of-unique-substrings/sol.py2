class Solution(object):
    def maxUniqueSplit(self, s):
        """
        :type s: str
        :rtype: int
        """
        used=set()
        ans=[0]
        def backtrack(index):
            if index==len(s):
                ans[0]=max(ans[0],len(used))
                return
            for j in range(index,len(s)):
                curr=s[index:j+1]
                if curr in used:
                    continue
                used.add(curr)
                backtrack(j+1)
                used.remove(curr)
        backtrack(0)
        return ans[0]
