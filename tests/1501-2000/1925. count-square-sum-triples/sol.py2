class Solution(object):
    def countTriples(self, n):
        """
        :type n: int
        :rtype: int
        """
        cnt = 0
        nsqrt = int(n ** 0.5)
        for s in range(2, nsqrt + 1):
            for t in range((s & 1) + 1, s, 2):
                a, b = s, t
                while b:
                    a, b = b, a % b
                if a != 1:
                    continue
                c = s * s + t * t
                if c > n:
                    break
                k = n // c
                cnt += 2 * k
        return cnt
