class Solution(object):
    def checkWays(self, pairs):
        """
        :type pairs: List[List[int]]
        :rtype: int
        """
        graph = {}
        for x, y in pairs:
            graph.setdefault(x, set()).add(y)
            graph.setdefault(y, set()).add(x)

        if not graph:
            return 0
        root = max(graph, key=lambda node: len(graph[node]))
        if len(graph[root]) != len(graph) - 1:
            return 0

        ans = 1
        for node in graph:
            if node == root:
                continue
            parents = [candidate for candidate in graph[node]
                       if len(graph[candidate]) >= len(graph[node])]
            if not parents:
                return 0
            parent = min(parents, key=lambda candidate: len(graph[candidate]))
            if graph[node] - (graph[parent] | {parent}):
                return 0
            if len(graph[node]) == len(graph[parent]):
                ans = 2
        return ans
