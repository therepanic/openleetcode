class Solution(object):
    def minNonZeroProduct(self, p):
        """
        :type p: int
        :rtype: int
        """
        MOD = 10**9 + 7
        max_num = (1 << p) - 1
        count = (1 << (p - 1)) - 1
        
        def mod_pow(x, n):
            result = 1
            x = x % MOD
            while n:
                if n % 2:
                    result = result * x % MOD
                x = x * x % MOD
                n //= 2
            return result

        return int((mod_pow(max_num - 1, count) * max_num) % MOD)
