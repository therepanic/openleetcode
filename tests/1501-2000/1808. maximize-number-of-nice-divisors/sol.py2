class Solution(object):
    def maxNiceDivisors(self, primeFactors):
        """
        :type primeFactors: int
        :rtype: int
        """
        MOD = 10**9 + 7
        if primeFactors == 1:
            return 1
        q, r = divmod(primeFactors, 3)
        if r == 0:
            return pow(3, q, MOD)
        elif r == 1:
            return pow(3, q-1, MOD) * 4 % MOD
        else:
            return pow(3, q, MOD) * 2 % MOD
