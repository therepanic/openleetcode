class Solution(object):
    def check(self, a):
        a = sorted(a)
        if len(a) == 1 or len(a) == 2:
            return True
        d = a[1] - a[0]
        for i in range(1, len(a)-1):
            if a[i+1] - a[i] != d:
                return False
        return True
    def checkArithmeticSubarrays(self, nums, l, r):
        ans = []
        for i in range(len(l)):
            ans.append(self.check(nums[l[i]:r[i]+1]))
        return ans
