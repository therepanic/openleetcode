class Solution(object):
    def minOperations(self, logs):
        """
        :type logs: List[str]
        :rtype: int
        """
        output = 0 
        for i in logs : 
            if i == "../" :
                output -= 1
                if output < 0 :
                    output = 0 
            elif i == "./" :
                continue 
            else :
                output += 1 
        if output < 0 :
            return 0 
        else :
            return output
