class Solution(object):
    def getWinner(self, arr, k):
        """
        :type arr: List[int]
        :type k: int
        :rtype: int
        """
        candidate = arr[0]
        streak = 0
        for el in arr[1:]:
            if candidate > el:
                streak += 1
            else:
                candidate = el
                streak = 1
            if streak == k:
                return candidate
        return candidate
