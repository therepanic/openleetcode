class Solution(object):
    def maximalNetworkRank(self, n, roads):
        """
        :type n: int
        :type roads: List[List[int]]
        :rtype: int
        """
        A = [[0] * n for _ in range(n)]
        for u, v in roads:
            A[u][v] = 1
            A[v][u] = 1
        
        d = [sum(row) for row in A]
        
        Rank = [[-1] * n for _ in range(n)]
        for i in range(n):
            for j in range(n):
                if i != j:
                    Rank[i][j] = d[i] + d[j] - A[i][j]
        
        return max(max(row) for row in Rank)
