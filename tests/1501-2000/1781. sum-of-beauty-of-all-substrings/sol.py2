class Solution(object):
    def beautySum(self, s):
        """
        :type s: str
        :rtype: int
        """
        n = len(s)
        sum_of_beauty = 0
        for i in range(n):
            freq = [0] * 26
            for j in range(i, n):
                freq[ord(s[j]) - 97] += 1
                maxi = float('-inf')
                mini = float('inf')
                for diff in freq:
                    if diff > 0:
                        maxi = max(maxi, diff)
                        mini = min(mini, diff)
                sum_of_beauty += (maxi - mini)
        return sum_of_beauty
