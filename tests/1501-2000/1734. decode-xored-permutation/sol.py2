class Solution(object):
    def decode(self, encoded):
        """
        :type encoded: List[int]
        :rtype: List[int]
        """
        n = len(encoded) + 1
        xr = 0
        for i in range(1, n + 1):
            xr ^= i
        nxr = 0
        for i in range(len(encoded)):
            if i % 2 == 1:
                nxr ^= encoded[i]
        perm = [xr ^ nxr]
        for i in range(len(encoded)):
            perm.append(encoded[i] ^ perm[i])
        return perm
