class Solution(object):
    def canSeePersonsCount(self, heights):
        """
        :type heights: List[int]
        :rtype: List[int]
        """
        n = len(heights)
        result = [0]*n
        stack = []

        for i in range(n-1,-1,-1):
            height = heights[i]
            visibility = 0

            while stack and height > stack[-1]:
                stack.pop()
                visibility += 1

            if(stack):
                visibility += 1

            result[i]=visibility
            stack.append(height)
        return result
