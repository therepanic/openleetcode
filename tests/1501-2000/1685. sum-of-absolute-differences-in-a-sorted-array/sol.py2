class Solution(object):
    def getSumAbsoluteDifferences(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        n = len(nums)
        pref = [0] * n
        pref[0] = nums[0]
        for i in range(1, n):
            pref[i] = pref[i-1] + nums[i]
        ans = []
        for i in range(n):
            left = pref[i-1] if i > 0 else 0
            right = pref[n-1] - pref[i]
            ans.append(right - left + (2*i - n + 1) * nums[i])
        return ans
