class Solution(object):
    def canConvertString(self, s, t, k):
        """
        :type s: str
        :type t: str
        :type k: int
        :rtype: bool
        """
        if len(s) != len(t):
            return False
        shift_count = [0] * 26
        for i in range(len(s)):
            if s[i] == t[i]:
                continue
            diff = (ord(t[i]) - ord(s[i])) % 26
            shift_count[diff] += 1
            if diff + 26 * (shift_count[diff] - 1) > k:
                return False
        return True
