class Solution(object):
    def findBall(self, grid):
        """
        :type grid: List[List[int]]
        :rtype: List[int]
        """
        m, n = len(grid), len(grid[0])
        result = []
        for col in range(n):
            cur = col
            for row in range(m):
                d = grid[row][cur]
                nxt = cur + d
                if nxt < 0 or nxt >= n or grid[row][nxt] != d:
                    cur = -1
                    break
                cur = nxt
            result.append(cur)
        return result
