class Solution(object):
    def closestToTarget(self, arr, target):
        answer = 1 << 60
        previous = []
        for value in arr:
            current = [value]
            for old in previous:
                candidate = old & value
                if candidate != current[-1]:
                    current.append(candidate)
            for candidate in current:
                answer = min(answer, abs(candidate - target))
            previous = current
        return answer
